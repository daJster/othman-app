  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "preview:web": "node scripts/serve-web.mjs",
    "check:web": "node scripts/check-web-export.mjs",
    "deploy": "npm run build:web && npm run check:web && npx firebase-tools deploy --only hosting",
    "build:ios": "expo export --platform ios",
    "build:android": "expo export --platform android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "check:core": "node scripts/check-core-purity.mjs",
    "check:i18n": "node scripts/i18n-audit.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"*.{ts,js}\" \"scripts/**/*.mjs\" \"MIGRATE.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"*.{ts,js}\" \"scripts/**/*.mjs\" \"MIGRATE.md\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "verify": "npm run typecheck && npm run typecheck:core && npm run check:core && npm run check:i18n && npm run lint && npm run format:check && npm test"
  },
  "private": true

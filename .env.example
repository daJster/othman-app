# Firebase web app credentials.
# Copy to `.env` (gitignored) and fill in. Values come from
# Firebase console → Project settings → Your apps → Web app → SDK setup.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google OAuth client IDs (used by P3.3 on native; web uses signInWithPopup and
# needs none). From Google Cloud console → Credentials. The iOS client is a
# "iOS" OAuth client, the Android one is an "Android" client bound to the
# package name + SHA-1 of the signing key.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Optional. Exact redirect URI registered for the native OAuth clients. Leave
# empty to use the app scheme (`othman://auth`); set it when the console entry
# differs (for example a reversed-client-ID scheme). It must match exactly.
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=
